---
import SectionHeader from './SectionHeader.astro';
import { sanityImg } from '../lib/format';
import type { Gallery } from '../lib/content';

interface Props {
  content: Gallery;
}

const { content } = Astro.props;

// Editors pick a focal point in Studio; use it so the important part survives cropping.
const focus = (h: { x: number; y: number } | null) =>
  h ? `${Math.round(h.x * 100)}% ${Math.round(h.y * 100)}%` : '50% 50%';
---

<section class="gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <SectionHeader
      eyebrow={content.eyebrow}
      heading={content.heading}
      intro={content.intro}
      titleId="gallery-title"
    />

    <ul class="gallery__grid">
      {
        content.items.map((photo) => (
          <li class="tile">
            <figure class="tile__figure">
              <img
                class="tile__image"
                src={sanityImg(photo.url, 900)}
                srcset={[500, 900, 1400].map((w) => `${sanityImg(photo.url, w)} ${w}w`).join(', ')}
                sizes="(min-width: 640px) 50vw, 100vw"
                width={photo.width}
                height={photo.height}
                alt={photo.alt ?? ''}
                loading="lazy"
                decoding="async"
                style={`object-position: ${focus(photo.hotspot)}`}
              />
              <figcaption class="tile__caption">{photo.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery {
    background: var(--color-white);
    padding-block: clamp(3.5rem, 2rem + 4vw, 5rem);
  }

  /* Mobile first: one photo per row. */
  .gallery__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 3rem;
  }

  .tile__figure {
    position: relative;
    height: 23rem; /* same height in every frame; width changes, the crop adapts */
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--color-ink-900);
  }

  .tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Darkens the bottom so the white caption stays readable on any photo. */
  .tile__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.6) 0%, rgb(0 0 0 / 0) 50%);
    pointer-events: none;
  }

  .tile__caption {
    position: absolute;
    z-index: 1;
    inset: auto 1.4rem 1.4rem;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-white);
    text-wrap: balance;
  }

  /* 640px+: two photos on top, the third spans the full width. */
  @media (min-width: 640px) {
    .gallery__grid {
      grid-template-columns: 1fr 1fr;
    }
    .tile:nth-child(3) {
      grid-column: 1 / -1;
    }
  }
</style>
