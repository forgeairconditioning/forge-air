---
/**
 * Inlines an SVG from src/assets/icons/<name>.svg so it can take its color from CSS (currentColor).
 * Export each icon from Figma as SVG and drop it in that folder. If the file doesn't exist yet,
 * nothing is rendered, so the page still builds while icons are missing.
 *
 * Hard-coded fill/stroke colors are replaced with currentColor automatically.
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
const icons = import.meta.glob<string>('../assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const raw = icons[`../assets/icons/${name}.svg`];

// Recolor hard-coded fill/stroke values to currentColor so CSS "color" controls the icon.
// Anything from <defs> onward (clipPaths, gradients) is left alone, as is "none".
const recolor = (src: string) => {
  const i = src.indexOf('<defs');
  const head = i === -1 ? src : src.slice(0, i);
  const tail = i === -1 ? '' : src.slice(i);
  return (
    head.replace(/(fill|stroke)="(?!none|currentColor|url)[^"]*"/g, '$1="currentColor"') + tail
  );
};
const svg = raw && recolor(raw);
---

{svg && <span class:list={['icon', className]} aria-hidden="true" set:html={svg} />}

<style>
  .icon {
    display: inline-flex;
    flex: none;
    width: 1.25em;
    height: 1.25em;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
